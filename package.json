{
  "name": "chrisbalola-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:development": "env-cmd -f .env.development next dev",
    "start:staging": "env-cmd -f .env.staging next dev",
    "start:production": "env-cmd -f .env.production next dev",
    "build:development": "env-cmd -f .env.development next build",
    "build:staging": "env-cmd -f .env.staging next build",
    "build:production": "env-cmd -f .env.production next build",
    "build:dev": "tsc -b && next build && tsc -b --clean",
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p $PORT",
    "lint:check": "eslint",
    "lint": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "16.1.5",
    "next-intl": "^4.7.0",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "rooks": "^9.5.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.0",
    "@storybook/addon-a11y": "^10.2.10",
    "@storybook/addon-docs": "^10.2.10",
    "@storybook/addon-themes": "^10.2.10",
    "@storybook/nextjs": "^10.2.10",
    "@storybook/react": "^10.2.10",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "env-cmd": "^11.0.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.4",
    "eslint-plugin-storybook": "^10.2.10",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "railway": "^3.16.0",
    "storybook": "^10.2.10",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  }
}
