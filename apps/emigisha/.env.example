# Canonical site URL, used for metadata
NEXT_PUBLIC_SITE_URL=https://emigisha.com

# Contact address shown in the nav and footer
NEXT_PUBLIC_CONTACT_EMAIL=hello@emigisha.com

# Outbound links
NEXT_PUBLIC_LINK_MENEJA=https://about.meneja.app
NEXT_PUBLIC_LINK_TALATALA=https://talatala.app
NEXT_PUBLIC_LINK_STYLEDDOC=https://styleddoc.app
NEXT_PUBLIC_LINK_FOUNDER=https://chrisbalola.com

# Cloudflare Web Analytics beacon token (leave empty to disable)
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
