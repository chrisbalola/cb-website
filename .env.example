# Environment
ENVIRONMENT=development

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Social Links
NEXT_PUBLIC_SOCIAL_GITHUB=https://github.com/chrisbalola
NEXT_PUBLIC_SOCIAL_X=https://x.com/chrisbalola
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/in/chrisbalola

# Analytics (Cloudflare Web Analytics)
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
