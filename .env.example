# This is an example environment variable file.
# Replace the placeholder values with your actual configuration values.
# One has to create one for each environment (`.env.development`, `.env.staging`, `.env.production`).
# ---

# Environment
ENVIRONMENT=development

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Links (all optional, defaults point to the live profiles)
NEXT_PUBLIC_LINK_BLOG=https://blog.chrisbalola.com
NEXT_PUBLIC_SOCIAL_X=https://x.com/chrisbalola
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/in/chrisbalola
NEXT_PUBLIC_CONTACT_EMAIL=hello@chrisbalola.com
NEXT_PUBLIC_LINK_MENEJA=https://about.meneja.app

# Analytics (Cloudflare Web Analytics)
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
